{
    "manifest_version": 3,
    "name": "webtool",
    "version": "0.1",
    "permissions": [
        "tabs"
    ],
    "background": {
        "scripts": ["background.js"]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "webtool-id@webtool-id.domain",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "data_collection_permissions": {
        "required": [
            "none"
        ]
    }
}
